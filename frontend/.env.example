# Copy to .env.local and fill in from `cdk deploy --outputs-file`.
# None of these are secrets: pool/client ids and domains are public config.
VITE_API_URL=https://xxxxxxxxxx.execute-api.ap-southeast-2.amazonaws.com
VITE_COGNITO_USER_POOL_ID=ap-southeast-2_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AUDIO_DOMAIN=dxxxxxxxxxxxxx.cloudfront.net
# Pipeline stack output JobTimeoutMs. Polling for less than the state machine's
# own timeout reports a failure for a job that is still running -- and still
# gets billed. Omit to fall back to the CDK default (30 minutes).
VITE_JOB_TIMEOUT_MS=2100000
