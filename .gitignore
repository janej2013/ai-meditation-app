# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Lambda layers — generated by scripts/build_layers.sh, never committed.
# ffmpeg is ~80MB of GPL binaries; the shared layer is a pip install.
layers/shared/python/*
!layers/shared/python/.gitkeep
layers/ffmpeg/bin/*
!layers/ffmpeg/bin/.gitkeep

# Audio written by scripts/tts_preview.py while tuning the voice by ear.
tts-preview/

# Playwright: browsers live in a user cache, these are per-run artefacts.
# .auth holds a captured Cognito session -- real tokens for a real account.
frontend/playwright-report/
frontend/test-results/
frontend/e2e/.auth/

# Scratch space for one-off artefacts (IAM policy documents fed to the
# aws CLI, captured outputs, ...). Never source, never committed.
tmp/

# CDK
cdk.out/
.cdk.staging/
# Written by `cdk deploy --outputs-file`; per-deployment, not source.
cdk-outputs.json

# Node / frontend
node_modules/
dist/
dev-dist/
.vite/
*.tsbuildinfo

# Secrets & local env (see CLAUDE.md constraint 4 — never commit secrets)
.env
.env.*
!.env.example
# The CloudFront URL-signing key pair (README: frontend delivery). The private
# key lives in Secrets Manager; the public half stays local for `make deploy`.
cf-signing*.pem

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
